{
  "name": "stemred-desktop",
  "version": "0.1.22",
  "private": false,
  "license": "MIT",
  "homepage": "https://chat-stem.ru/",
  "repository": {
    "type": "git",
    "url": "https://github.com/redkipov/stemred-desktop.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run build:win",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1",
    "build:store": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -MicrosoftStore",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -BumpPatch",
    "release:store": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1 -MicrosoftStore -BumpPatch",
    "build:tauri": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vite build && node ./scripts/check-music-runtime.mjs",
    "check:music": "node ./scripts/check-music-runtime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
}
