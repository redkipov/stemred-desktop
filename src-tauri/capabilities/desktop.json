{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop shell capability for local fallback and trusted STEM web origin.",
  "windows": ["main", "music-mini"],
  "local": true,
  "remote": {
    "urls": ["https://chat-stem.ru", "https://chat-stem.ru/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-stem-desktop-commands",
    "deep-link:default",
    "notification:default",
    "opener:default",
    "opener:allow-open-path",
    "process:allow-restart",
    "updater:default"
  ]
}
